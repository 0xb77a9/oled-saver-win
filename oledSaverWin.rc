/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_SETTINGS DIALOGEX 0, 0, 200, 100
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "OLED Saver Settings"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Idle Time (seconds):",-1,10,12,80,10
    EDITTEXT        IDC_IDLE_TIME,100,10,40,14,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Dim Percentage (0-100):",-1,10,32,85,10
    EDITTEXT        IDC_DIM_PERCENT,100,30,40,14,ES_AUTOHSCROLL | ES_NUMBER
    AUTOCHECKBOX    "Run at startup",IDC_AUTOSTART,10,52,80,10
    DEFPUSHBUTTON   "OK",IDOK,90,75,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,143,75,50,14
END

